# syntax = docker/dockerfile:1.11-labs

FROM input AS build-deb
ARG rust_target
ARG rust_toolchain
ARG RUSTUP_HOME
ARG CARGO_HOME
ARG CARGO_TARGET
ARG CARGO_TARGET_DIR
ARG cargo_target_profile
ARG cargo_profile
ARG cargo_features
ARG cargo_spec_features
ARG pkg_dir
ARG deb_args=""
ARG sched_policy="--rr"
ARG sched_prio=1

WORKDIR /usr/src/tuwunel
ENV sched_policy=${sched_policy}
ENV sched_prio=${sched_prio}
# The packaging inputs (maintainer scripts, docs) live outside the compile
# subset carried by the input layer, so mount them from the full source.
RUN \
--mount=type=cache,dst=${RUSTUP_HOME}/downloads,sharing=shared \
--mount=type=cache,dst=${CARGO_HOME}/registry,sharing=shared \
--mount=type=cache,dst=${CARGO_HOME}/git,sharing=shared \
--mount=type=bind,from=source,source=/usr/src/tuwunel/debian,target=/usr/src/tuwunel/debian \
--mount=type=bind,from=source,source=/usr/src/tuwunel/README.md,target=/usr/src/tuwunel/README.md \
--mount=type=bind,from=source,source=/usr/src/tuwunel/LICENSE,target=/usr/src/tuwunel/LICENSE \
<<EOF
    set -eux
    mkdir -p "${pkg_dir}"
    rustup run ${rust_toolchain} sched_wrap.sh \
        cargo deb \
            --verbose \
            --locked \
            --no-build \
            "${cargo_spec_features}" \
            --features "${cargo_features}" \
            --profile "${cargo_profile}" \
            --target "${CARGO_TARGET}" \
            --manifest-path Cargo.toml \
            --multiarch same \
            --compress-type gz \
            --output "${pkg_dir}" \
            ${deb_args}

	mv ${pkg_dir}/* "${pkg_dir}/tuwunel.deb"
	dpkg --info "${pkg_dir}/tuwunel.deb"
	dpkg --contents "${pkg_dir}/tuwunel.deb"
EOF


FROM scratch AS deb
ARG pkg_dir

COPY --from=input ${pkg_dir}/tuwunel.deb .


FROM input AS deb-install
ARG pkg_dir

WORKDIR ${pkg_dir}
COPY --from=deb . .
# apt resolves the Depends the package declares, where dpkg only asserts they
# are installed already. The runtime image carries no more than base_pkgs, so
# a bare dpkg --install failed on each dependency the package gained until
# that list was edited to match it.
RUN <<EOF
	set -eux
	dpkg --info tuwunel.deb
	dpkg --contents tuwunel.deb
	apt-get -y update
	apt-get -y install --no-install-recommends ./tuwunel.deb
	# Every program the unit runs comes from the package or from something it
	# depends on, so hold them against the filesystem the install produced.
	sed -nE 's/^Exec[A-Za-z]+=[-+!@]*(\/[^ ]+).*/\1/p' \
		/usr/lib/systemd/system/tuwunel.service | xargs -rt -n1 test -x
EOF
