    {
      "name": "rooms: valid",
      "key": "com.chat-harness.notify.rooms",
      "content": {
        "v": 1,
        "updatedAt": 1792236875578,
        "rooms": {
          "!abc:shai.matrix": {
            "level": "humans",
            "snoozeUntil": 1792240475578,
            "muteAllThreads": false,
            "mutedThreads": [
              "$root1"
            ]
          },
          "!def:shai.matrix": {}
        }
      },
      "expected": {
        "v": 1,
        "updatedAt": 1792236875578,
        "rooms": {
          "!abc:shai.matrix": {
            "level": "humans",
            "snoozeUntil": 1792240475578,
            "muteAllThreads": false,
            "mutedThreads": [
              "$root1"
            ]
          },
          "!def:shai.matrix": {}
        }
      }
    },
    {
      "name": "rooms: bad room id -> defaults",
      "key": "com.chat-harness.notify.rooms",
      "content": {
        "v": 1,
        "rooms": {
          "abc": {
            "level": "muted"
          }
        }
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "rooms": {}
      }
    },
    {
      "name": "rooms: bad thread id -> defaults",
      "key": "com.chat-harness.notify.rooms",
      "content": {
        "v": 1,
        "rooms": {
          "!a:x": {
            "mutedThreads": [
              "root"
            ]
          }
        }
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "rooms": {}
      }
    },
    {
      "name": "rooms: rooms is an array -> defaults",
      "key": "com.chat-harness.notify.rooms",
      "content": {
        "v": 1,
        "rooms": []
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "rooms": {}
      }
    },
    {
      "name": "rooms: unknown room field ignored",
      "key": "com.chat-harness.notify.rooms",
      "content": {
        "v": 1,
        "rooms": {
          "!a:x": {
            "level": "muted",
            "color": "red"
          }
        }
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "rooms": {
          "!a:x": {
            "level": "muted"
          }
        }
      }
    },
    {
      "name": "schedule: valid, crosses midnight",
      "key": "com.chat-harness.notify.schedule",
      "content": {
        "v": 1,
        "updatedAt": 1792236875578,
        "timezone": "Asia/Jerusalem",
        "quietHours": [
          {
            "days": [
              0,
              1,
              2,
              3,
              4
            ],
            "start": "22:00",
            "end": "07:00"
          }
        ],
        "pauseUntil": null,
        "breakThrough": {
          "rooms": [
            "!abc:shai.matrix"
          ],
          "users": [
            "@roy:shai.matrix"
          ]
        }
      },
      "expected": {
        "v": 1,
        "updatedAt": 1792236875578,
        "timezone": "Asia/Jerusalem",
        "quietHours": [
          {
            "days": [
              0,
              1,
              2,
              3,
              4
            ],
            "start": "22:00",
            "end": "07:00"
          }
        ],
        "pauseUntil": null,
        "breakThrough": {
          "rooms": [
            "!abc:shai.matrix"
          ],
          "users": [
            "@roy:shai.matrix"
          ]
        }
      }
    },
