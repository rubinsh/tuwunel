{
  "spec": "notification-guard R10 §5.7",
  "cases": [
    {
      "name": "defaults: absent key",
      "key": "com.chat-harness.notify.defaults",
      "content": null,
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "accountLevel": "all",
        "botRoomLevel": null,
        "burstWindowSec": 0,
        "activeDeviceSuppression": false
      }
    },
    {
      "name": "defaults: unreadable key -> burst off",
      "key": "com.chat-harness.notify.defaults",
      "content": "not an object",
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "accountLevel": "all",
        "botRoomLevel": null,
        "burstWindowSec": 0,
        "activeDeviceSuppression": false
      }
    },
    {
      "name": "defaults: full valid",
      "key": "com.chat-harness.notify.defaults",
      "content": {
        "v": 1,
        "updatedAt": 1792236875578,
        "accountLevel": "mentions",
        "botRoomLevel": "humans",
        "burstWindowSec": 0,
        "activeDeviceSuppression": true
      },
      "expected": {
        "v": 1,
        "updatedAt": 1792236875578,
        "accountLevel": "mentions",
        "botRoomLevel": "humans",
        "burstWindowSec": 0,
        "activeDeviceSuppression": true
      }
    },
    {
      "name": "defaults: explicit 120 s burst is kept",
      "key": "com.chat-harness.notify.defaults",
      "content": {
        "v": 1,
        "burstWindowSec": 120
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "accountLevel": "all",
        "botRoomLevel": null,
        "burstWindowSec": 120,
        "activeDeviceSuppression": false
      }
    },
    {
      "name": "defaults: present key, missing fields take defaults (burstWindowSec 120), unknown ignored",
      "key": "com.chat-harness.notify.defaults",
      "content": {
        "v": 1,
        "updatedAt": 1792236875578,
        "accountLevel": "muted",
        "future": "x"
      },
      "expected": {
        "v": 1,
        "updatedAt": 1792236875578,
        "accountLevel": "muted",
        "botRoomLevel": null,
        "burstWindowSec": 120,
        "activeDeviceSuppression": false
      }
    },
    {
      "name": "defaults: bad level -> whole key defaults",
      "key": "com.chat-harness.notify.defaults",
      "content": {
        "v": 1,
        "updatedAt": 1792236875578,
        "accountLevel": "loud",
        "burstWindowSec": 30
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "accountLevel": "all",
        "botRoomLevel": null,
        "burstWindowSec": 0,
        "activeDeviceSuppression": false
      }
    },
    {
      "name": "defaults: unknown v -> defaults",
      "key": "com.chat-harness.notify.defaults",
      "content": {
        "v": 2,
        "updatedAt": 1792236875578,
        "accountLevel": "muted"
      },
      "expected": {
        "v": 1,
        "updatedAt": 0,
        "accountLevel": "all",
        "botRoomLevel": null,
        "burstWindowSec": 0,
        "activeDeviceSuppression": false
      }
    },
    {
      "name": "defaults: missing v -> defaults",
      "key": "com.chat-harness.notify.defaults",
      "content": {
        "updatedAt": 1792236875578,
        "accountLevel": "muted"
      },
